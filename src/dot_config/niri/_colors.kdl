// Matugen generated colors
// Layout configuration
layout {
    tab-indicator {
        active-color "#ffb2b7"
        inactive-color "#e7c08e"
    }
    insert-hint {
        gradient from="#72333980" to="#ffb2b780" angle=45 relative-to="workspace-view"
    }
    border {
        active-gradient from="#ffb2b7" to="#e6bdbe" angle=45 relative-to="workspace-view"
        inactive-gradient from="#524344" to="#9f8c8d" angle=45 relative-to="workspace-view"
        urgent-gradient from="#ffb4ab" to="#93000a" angle=45 relative-to="workspace-view"
    }
    shadow {
        color "#000000"
    }
}
// "Pin" picture-in-picture windows and apply another border colors to distinguish them better
window-rule {
    match title="^Picture-in-Picture$"
    default-floating-position x=32 y=32 relative-to="bottom-right"
    opacity 1.0
    border {
        active-gradient from="#e7c08e" to="#5c421a" angle=45
        inactive-gradient from="#e7c08e" to="#5c421a" angle=45
    }
}

recent-windows {
    // Round the corners on the highlight.
    highlight {
        corner-radius 14
        padding 2
        active-color "#ffb2b7" 
        urgent-color "#e7c08e"
    }
}
