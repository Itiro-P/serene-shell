    gitte
  )
}

package_serene-java() {
  pkgdesc="JDKs and Java build tools"
  depends=(
    jdk8-openjdk jdk11-openjdk jdk-openjdk jdk21-openjdk jdk25-openjdk
    archlinux-java-run maven gradle junit
  )
